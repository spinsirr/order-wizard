{
  "name": "@ordercue/extension",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "build": "wxt build",
    "build:local": "wxt build && rm -rf /mnt/c/ordercue-ext && cp -r .output/chrome-mv3 /mnt/c/ordercue-ext",
    "zip": "wxt zip",
    "lint": "biome lint",
    "lint:fix": "biome lint --write",
    "check:design": "node scripts/check-design.mjs",
    "format": "biome format --write",
    "typecheck": "wxt prepare && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf .output dist"
  },
  "dependencies": {
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource-variable/geist-mono": "5.3.0",
    "@tanstack/react-query": "^5.90.20",
    "@tanstack/react-virtual": "^3.13.24",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "exceljs": "^4.4.0",
    "jspdf": "^4.2.0",
    "jspdf-autotable": "^5.0.7",
    "ky": "^1.14.2",
    "lucide-react": "^0.545.0",
    "match-sorter": "^8.2.0",
    "oauth4webapi": "^3.8.3",
    "papaparse": "^5.5.3",
    "radix-ui": "^1.6.7",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "tailwind-merge": "^3.4.0",
    "tw-animate-css": "^1.4.0",
    "uuid": "^13.0.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.12",
    "@tailwindcss/postcss": "^4.1.18",
    "@testing-library/react": "^16.3.3",
    "@types/chrome": "^0.1.36",
    "@types/node": "^24.10.9",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19.2.9",
    "@types/react-dom": "^19.2.3",
    "@types/uuid": "^10.0.0",
    "@wxt-dev/module-react": "^1.2.1",
    "jsdom": "^30.0.1",
    "tailwindcss": "^4.1.18",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "~5.9.3",
    "vite": "^7.3.1",
    "vitest": "^4.1.0",
    "wxt": "^0.20.18"
  }
}
