{
  "name": "@ordercue/extension",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:workflow": "node scripts/dev-workflow.mjs",
    "storybook": "storybook dev --host 127.0.0.1 --port 6006 --exact-port --no-open --disable-telemetry",
    "build-storybook": "storybook build --disable-telemetry",
    "typecheck:storybook": "wxt prepare && tsc --noEmit -p tsconfig.storybook.json",
    "build": "wxt build",
    "build:demo": "NODE_ENV=production wxt build --mode demo --filter-entrypoint demo",
    "zip": "wxt zip",
    "lint": "biome check ../.. --error-on-warnings",
    "lint:fix": "biome check ../.. --write --error-on-warnings",
    "check:design": "node scripts/check-design.mjs",
    "format": "biome format ../.. --write",
    "typecheck": "wxt prepare && tsc --noEmit && tsc --noEmit -p tsconfig.storybook.json && tsc --noEmit -p tsconfig.test.json && tsc --noEmit -p ../../tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf .output .wxt storybook-static dist",
    "format:check": "biome format ../.."
  },
  "dependencies": {
    "@1natsu/wait-element": "4.1.2",
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource-variable/geist-mono": "5.3.0",
    "@js-temporal/polyfill": "0.5.1",
    "@tanstack/react-query": "^5.90.20",
    "@tanstack/react-virtual": "^3.13.24",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "exceljs": "^4.4.0",
    "jspdf": "^4.2.0",
    "jspdf-autotable": "^5.0.7",
    "ky": "^1.14.2",
    "lucide-react": "^0.545.0",
    "match-sorter": "^8.2.0",
    "oauth4webapi": "^3.8.3",
    "papaparse": "^5.5.3",
    "radix-ui": "^1.6.7",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "tailwind-merge": "^3.4.0",
    "tw-animate-css": "^1.4.0",
    "uuid": "^13.0.0",
    "xstate": "^5.33.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.13",
    "@storybook/react-vite": "10.6.0",
    "@tailwindcss/postcss": "^4.1.18",
    "@testing-library/react": "16.3.3",
    "@types/chrome": "^0.1.36",
    "@types/node": "^24.10.9",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19.2.9",
    "@types/react-dom": "^19.2.3",
    "@webext-core/fake-browser": "1.3.4",
    "@wxt-dev/module-react": "^1.2.1",
    "@xyflow/react": "12.11.6",
    "jsdom": "30.0.1",
    "storybook": "10.6.0",
    "tailwindcss": "^4.1.18",
    "typescript": "7.0.2",
    "vite": "^7.3.1",
    "vitest": "4.1.0",
    "wxt": "^0.20.18"
  }
}
