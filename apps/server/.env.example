PORT=3000
MONGODB_URI=mongodb://localhost:27017

# OAuth 2.0 Protected Resource Metadata (RFC 9728)
RESOURCE_URI=http://localhost:3000
# Optional comma-separated additions. RESOURCE_URI's host/origin and loopback
# hosts are included automatically.
MCP_ALLOWED_HOSTS=
MCP_ALLOWED_ORIGINS=
OIDC_ISSUER=https://cognito-idp.us-east-1.amazonaws.com/us-east-1_xxxxxxxxx
# Existing browser-extension public app client
OIDC_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx
# Optional separate CLI / agent public app client
OIDC_CLI_CLIENT_ID=
# Optional comma-separated pre-registered MCP host public clients.
OIDC_MCP_CLIENT_IDS=
