{
  "version": "1.1.3",
  "name": "ordercue",
  "packageManager": "bun@1.3.6",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "bun scripts/dev.ts",
    "build": "bun run --cwd apps/extension build && cargo build --workspace --release",
    "check": "bun scripts/check.ts",
    "test": "bun run --cwd apps/extension test && cargo test --workspace --locked",
    "test:mongo": "cargo test -p server --lib mongo_replication --locked -- --ignored",
    "typecheck": "bun run --cwd apps/extension typecheck",
    "lint": "bun run --cwd apps/extension lint",
    "lint:fix": "bun run --cwd apps/extension lint:fix",
    "format": "bun run --cwd apps/extension format && cargo fmt --all",
    "db": "docker-compose -f apps/server/docker-compose.yml up -d mongodb",
    "db:stop": "docker-compose -f apps/server/docker-compose.yml down",
    "bump": "bun scripts/set-version.ts",
    "setup": "git config core.hooksPath .githooks",
    "clean": "bun run --cwd apps/extension clean && cargo clean"
  },
  "overrides": {
    "publish-browser-extension": "6.1.1"
  },
  "devDependencies": {
    "@types/bun": "1.3.6",
    "zod": "4.3.6"
  }
}
