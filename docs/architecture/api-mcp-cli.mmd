%%{init: {"theme":"base","themeVariables":{"fontFamily":"Inter, ui-sans-serif, system-ui","primaryTextColor":"#172033","lineColor":"#64748b","clusterBkg":"#f8fafc","clusterBorder":"#cbd5e1"},"flowchart":{"curve":"basis","nodeSpacing":34,"rankSpacing":52}}}%%
flowchart TB
  U["最终用户"]

  subgraph Clients["用户设备与 Agent"]
    direction LR
    EXT["浏览器扩展<br/>offline-first 本地副本"]
    MCP_HOST["MCP Host / AI Agent"]
    SKILL_AGENT["Skill-capable AI Agent"]
    SKILL["OrderCue Skill<br/>选择命令 · 解释结果"]
    CLI["OrderCue CLI<br/>非交互 · 稳定 JSON"]

    SKILL_AGENT --> SKILL -->|"界面 3 · 本地调用"| CLI
  end


  U --> EXT
  U --> MCP_HOST
  U --> SKILL_AGENT

  subgraph Identity["身份与 MCP 授权门槛"]
    direction LR
    OAUTH_GATE["实施 MCP 前验证目标 Host<br/>注册 · redirect · resource · refresh"]
    IDP["Amazon Cognito OAuth<br/>PKCE · Access Token"]
  end

  EXT -. "登录" .-> IDP
  MCP_HOST -. "远程授权" .-> IDP
  CLI -. "首次人工登录" .-> IDP
  OAUTH_GATE -.-> MCP_HOST
  OAUTH_GATE -.-> IDP

  subgraph Server["Fly.io · Rust / Axum"]
    direction LR

    subgraph Adapters["服务端网络适配器"]
      direction LR
      REST["界面 1 · REST API<br/>扩展完整同步 · CLI 受限调用"]
      MCP["界面 2 · MCP 2026-07-28<br/>Streamable HTTP · 无 session"]
    end

    AUTH["认证模块<br/>issuer · resource/audience · scope<br/>输出 Principal"]
    APP["OrderApplication<br/>业务规则 · Agent 写入生成 updatedAt<br/>Extension：完整同步<br/>Agent：read/status/note<br/>禁止 create/delete/batch"]
    REPO["TenantScopedOrderRepository<br/>每个操作必须携带 UserId"]
    MONGO["MongoRepository Adapter"]

    REST --> AUTH
    MCP --> AUTH
    AUTH --> APP --> REPO --> MONGO
  end

  EXT -->|"HTTPS · 完整 CRUD<br/>pull/merge last-write-wins"| REST
  MCP_HOST -->|"MCP · 查询/详情/状态/备注"| MCP
  CLI -->|"HTTPS · 受限 scope<br/>查询/详情/状态/备注"| REST
  IDP -. "JWKS / OAuth metadata" .-> AUTH

  DB[("MongoDB Atlas<br/>共享云副本 · 无原生 RLS<br/>由 Repository 强制 user_id 隔离")]
  MONGO --> DB

  classDef person fill:#fff7ed,stroke:#f97316,color:#7c2d12,stroke-width:1.5px;
  classDef client fill:#eff6ff,stroke:#3b82f6,color:#1e3a8a,stroke-width:1.5px;
  classDef adapter fill:#ecfeff,stroke:#0891b2,color:#164e63,stroke-width:1.5px;
  classDef core fill:#f5f3ff,stroke:#7c3aed,color:#4c1d95,stroke-width:2px;
  classDef data fill:#ecfdf5,stroke:#059669,color:#064e3b,stroke-width:1.5px;
  classDef security fill:#fff1f2,stroke:#e11d48,color:#881337,stroke-width:1.5px;

  class U person;
  class EXT,MCP_HOST,SKILL_AGENT,SKILL,CLI client;
  class REST,MCP adapter;
  class APP,REPO core;
  class DB,MONGO data;
  class IDP,AUTH,OAUTH_GATE security;
